# Generated by the workspace package publish — do not edit by hand.
class Quickrust < Formula
  desc "Cargo, faster: every Cargo command, with managed toolchains and a shared build cache"
  homepage "https://github.com/machinefabric/quickrust"
  version "@{version}"
  license any_of: ["MIT", "Apache-2.0"]

  on_macos do
    if Hardware::CPU.arm?
      @{platform_block:darwin-arm64}
    else
      @{platform_block:darwin-x86_64}
    end
  end

  on_linux do
    if Hardware::CPU.arm?
      @{platform_block:linux-arm64}
    else
      @{platform_block:linux-x86_64}
    end
  end

  def install
    # The archive extracts to @{bundle_dir}/{qrust,qrust-rustc-wrapper,LICENSE-*,README.md}, and
    # Homebrew runs this from inside that single top-level directory. The two programs stay
    # together: `qrust setup` copies both from where `qrust` is.
    libexec.install Dir["*"]
    bin.install_symlink libexec/"qrust"
  end

  def caveats
    <<~EOS
      Run `qrust setup` to make QuickRust your cargo: it installs itself and stable Rust
      under ~/.qrust and puts ~/.qrust/bin on your PATH.
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/qrust --version")
  end
end
